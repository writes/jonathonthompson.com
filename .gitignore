.env

# Sitecore specific
# Sitecore data folder
/data

# Sitecore logs
/App_Data/logs/

# Sitecore temp files
/App_Data/temp/

# Sitecore packages
/App_Data/packages/

# Sitecore diagnostic files
/App_Data/diagnostics/

# Sitecore indexes
/App_Data/indexes/

# Sitecore configuration patches (uncomment if you want to ignore)
/App_Config/Include/zzz*

# Sitecore license file
/App_Data/*.xml

# JSS specific
# JSS app configuration (uncomment if you want to ignore)
/sitecore/config/*.config

# JSS build artifacts
/dist/
/build/
/artifacts/

# JSS development files
/.jss
/.vscode/settings.json

# Sitecore Experience Editor
/sitecore/shell/Applications/WebEdit/Temp/

# Sitecore cache
/App_Data/cache/

# Sitecore media cache
/App_Data/MediaCache/

# Sitecore view state
/App_Data/ViewState/

# Additional common ignores for our project
# IDE files
.vscode/
.idea/
*.swp
*.swo

